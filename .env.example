# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FHEM_ALLOWED_HOSTS: Optional comma-separated allowlist of local/private FHEM server hosts
# permitted through the backend HTTP/HTTPS proxy (e.g., "192.168.178.50,fhem.local").
# Cloud metadata and loopback addresses are always blocked.
FHEM_ALLOWED_HOSTS=""

# Optional OpenAI-compatible AI Assistant defaults (can also be configured encrypted per-device in the app UI)
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_ALLOWED_HOSTS=""

