# ==============================================================================
# FHEM Control Desk – Beispiel-Konfiguration (.env.example)
# ==============================================================================
# Für den eigenen Betrieb diese Datei kopieren:
#   cp .env.example .env
# Danach in der .env die gewünschten Werte eintragen (diese Datei NIEMALS
# mit echten Passwörtern in Git einchecken – .env steht in .gitignore).
# Ausführliche Anleitung: siehe SETUP.md
# ==============================================================================

# Zeitzone & optionale Port-Bindung (z. B. "127.0.0.1:3000" hinter Reverse Proxy)
TZ="Europe/Berlin"
APP_PORT_BIND="3000"

# Öffentliche URL, unter der die App erreichbar ist (optional)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 1. EXKLUSIVER FHEM-STACK-MODUS (EMPFOHLEN FÜR PRODUKTIV-INTEGRATION)
# ------------------------------------------------------------------------------
# Wenn FHEM_UPSTREAM_URL gesetzt ist, verbindet sich FHEM Control Desk beim Start
# automatisch mit genau diesem FHEM-Server – ganz ohne manuelles Server-Setup im
# Browser. Alle FHEM-Zugangsdaten bleiben ausschließlich auf dem Server!
#
# Beispiele:
#   Neuer Docker-Stack (docker-compose.stack.yml):  http://fhem:8083/fhem
#   Bestehendes FHEM im Heimnetz:                   http://192.168.178.50:8083/fhem
#   Natives FHEM auf demselben Linux-Host (systemd): http://127.0.0.1:8083/fhem
#   Natives FHEM vom Docker-Container aus:          http://host.docker.internal:8083/fhem
FHEM_UPSTREAM_URL=""

# "true"  = Exklusive WebUI: sperrt Test-Instanz und andere Ziel-Server komplett
#           (alle Benutzer steuern ausschließlich den FHEM_UPSTREAM_URL-Server).
# "false" = FHEM_UPSTREAM_URL dient als vorkonfigurierter Standard, Nutzer können
#           optional noch umschalten.
FHEM_EXCLUSIVE_MODE="true"

# HTTP-Methode (GET oder POST) & CSRF-Verhalten (auto | none | manual)
FHEM_UPSTREAM_METHOD="GET"
FHEM_UPSTREAM_CSRF_MODE="auto"
FHEM_UPSTREAM_CSRF_TOKEN=""

# Optionale Authentifizierung am internen FHEM-Server:
# Werte für FHEM_UPSTREAM_AUTH_TYPE: none | basic | apikey | custom_header | query_token
# (Leer lassen = automatische Erkennung anhand der ausgefüllten Felder unten)
FHEM_UPSTREAM_AUTH_TYPE=""
FHEM_UPSTREAM_USER=""
FHEM_UPSTREAM_PASS=""
FHEM_UPSTREAM_API_KEY=""
FHEM_UPSTREAM_HEADER_NAME=""
FHEM_UPSTREAM_HEADER_VALUE=""
FHEM_UPSTREAM_QUERY_PARAM=""
FHEM_UPSTREAM_QUERY_VALUE=""
FHEM_UPSTREAM_ACCEPT_SELF_SIGNED="false"

# ------------------------------------------------------------------------------
# 2. FHEM-SERVER-FREIGABE (NUR OHNE FHEM_UPSTREAM_URL / IM MANUELLEN MODUS)
# ------------------------------------------------------------------------------
# Kommagetrennte Liste privater LAN-IPs/Hostnamen, die im manuellen Modus über
# den Backend-Proxy erreicht werden dürfen (z. B. "192.168.178.50,fhem.fritz.box").
FHEM_ALLOWED_HOSTS=""

# ------------------------------------------------------------------------------
# 3. SPEICHERORT FÜR BENUTZERKONTEN & PROFIL-SYNC
# ------------------------------------------------------------------------------
# Im Docker-Container automatisch auf /app/data gesetzt (Volume "fhem_desk_data").
# Nur anpassen, wenn du die App direkt ohne Docker startest (Standard: ./data).
DATA_DIR=""

# ------------------------------------------------------------------------------
# 4. LOGIN-PFLICHT & ERSTEINRICHTUNG (INTERNET-BETRIEB)
# ------------------------------------------------------------------------------
# "true"  = Pflicht-Anmeldebildschirm aktiv; alle FHEM-/KI-Endpunkte sind
#           serverseitig ohne gültige Benutzer-Anmeldung gesperrt (EMPFOHLEN!).
# "false" = Kein Pflicht-Login beim Start (NUR in einem isolierten LAN nutzen!).
REQUIRE_LOGIN="true"

# Optionaler einmaliger Einrichtungs-Code für das ALLERERSTE Admin-Konto.
# Sinnvoll, wenn der Container direkt am Internet hängt, damit niemand vor dir
# das erste Admin-Konto anlegen kann. Nach dem Anlegen wieder entfernen.
ADMIN_BOOTSTRAP_TOKEN=""

# ------------------------------------------------------------------------------
# 5. OPTIONALER HTTP-BASIC-AUTH-SCHUTZ (ZUSÄTZLICHE SCHUTZSCHICHT)
# ------------------------------------------------------------------------------
# Nur aktiv im Produktionsbetrieb (NODE_ENV=production). Wenn BEIDE gesetzt sind,
# fragt der Browser zusätzlich vor dem Laden der App nach Benutzername & Passwort.
APP_AUTH_USER=""
APP_AUTH_PASS=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL: KI-ASSISTENT STANDARDWERTE (OPENAI-KOMPATIBEL / OLLAMA)
# ------------------------------------------------------------------------------
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_ALLOWED_HOSTS=""
